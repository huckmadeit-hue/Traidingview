//@version=5
indicator("VWAP Orderflow Buy/Sell Signals", overlay=true)

// ----------------------------
// Inputs
// ----------------------------
cvdLength       = input.int(20, "CVD SMA Length", minval=1)
useVolume       = input.bool(true, "Use Volume in CVD")
showVWAP        = input.bool(true, "Show VWAP Line")
signalSize      = input.string("large", "Signal Size", options=["tiny", "small", "normal", "large", "huge"])

// ----------------------------
// VWAP
// ----------------------------
vwapLine = ta.vwap(close)

// ----------------------------
// Improved CVD Calculation
// ----------------------------
// Volume-weighted delta for better order flow approximation
candleRange = high - low
deltaRaw = candleRange > 0 ? (close - open) / candleRange : 0
delta = useVolume ? deltaRaw * volume : (close - open)

// Use rolling sum instead of unbounded cumulative
cvd = math.sum(delta, cvdLength)
cvdSMA = ta.sma(cvd, cvdLength)

// ----------------------------
// Signal Conditions
// ----------------------------
vwapCrossUp   = ta.crossover(close, vwapLine)
vwapCrossDown = ta.crossunder(close, vwapLine)
bullishCandle = close > open
bearishCandle = close < open
cvdBullish    = cvd > cvdSMA
cvdBearish    = cvd < cvdSMA

// ----------------------------
// Buy/Sell Signals
// ----------------------------
buySignal  = vwapCrossUp and cvdBullish and bullishCandle
sellSignal = vwapCrossDown and cvdBearish and bearishCandle

// ----------------------------
// Convert size string to size type
// ----------------------------
labelSize = switch signalSize
    "tiny"   => size.tiny
    "small"  => size.small
    "normal" => size.normal
    "large"  => size.large
    "huge"   => size.huge
    => size.large

// ----------------------------
// Plot VWAP
// ----------------------------
plot(showVWAP ? vwapLine : na, "VWAP", color=color.yellow, linewidth=2)

// ----------------------------
// Plot Buy/Sell Labels
// ----------------------------
plotshape(
     buySignal,
     title = "BUY",
     style = shape.labelup,
     color = color.green,
     textcolor = color.white,
     text = "BUY",
     size = labelSize,
     location = location.belowbar)

plotshape(
     sellSignal,
     title = "SELL",
     style = shape.labeldown,
     color = color.red,
     textcolor = color.white,
     text = "SELL",
     size = labelSize,
     location = location.abovebar)

// ----------------------------
// Alerts
// ----------------------------
alertcondition(buySignal, title="BUY Alert", message="VWAP + CVD BUY SIGNAL")
alertcondition(sellSignal, title="SELL Alert", message="VWAP + CVD SELL SIGNAL")
